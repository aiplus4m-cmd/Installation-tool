<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>WinSetupHelper</RootNamespace>
    <AssemblyName>WinSetupHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Windows Setup Helper</Product>
    <Description>Công cụ hỗ trợ cài đặt nhanh ứng dụng sau khi cài Windows - NhảmStudio (https://topvl.net)</Description>
    <Company>NhảmStudio</Company>
    <Authors>NhảmStudio</Authors>
    <Copyright>© NhảmStudio - https://topvl.net</Copyright>
    <PackageProjectUrl>https://topvl.net</PackageProjectUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="apps.json" LogicalName="WinSetupHelper.apps.json" />
    <Resource Include="app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
